<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MorditasTithe</AssemblyName>
    <RootNamespace>MorditasTithe</RootNamespace>
    <Version>0.4.1</Version>
  </PropertyGroup>

  <!-- Loader and game assemblies come from the install; they are never copied or committed. -->
  <ItemGroup>
    <Reference Include="$(MelonLoaderPath)\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(MelonLoaderPath)\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(MelonLoaderPath)\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(Il2CppAssembliesPath)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Il2CppAssembliesPath)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Il2CppAssembliesPath)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(Il2CppAssembliesPath)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(Il2CppAssembliesPath)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Il2CppAssembliesPath)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Il2CppAssembliesPath)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(Il2CppAssembliesPath)\Il2CppLE.dll" Private="false" />
  </ItemGroup>

  <!-- How Eterra's Gift shows the settings: read from the DLL, so it travels with the mod. -->
  <ItemGroup>
    <EmbeddedResource Include="ModSettings.json" LogicalName="ModSettings.json" />
  </ItemGroup>

  <!-- Eterra's Gift's Mods page builds and installs the mod. -p:DeployToGame=true copies a build straight into the game's
       Mods folder instead, where a running game holds the DLL and the app's mod library does not know the build. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true' And Exists('$(GamePath)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\Mods" />
  </Target>
</Project>
